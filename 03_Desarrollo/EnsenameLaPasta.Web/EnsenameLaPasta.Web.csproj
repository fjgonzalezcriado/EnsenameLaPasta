<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\EnsenameLaPasta.Application\EnsenameLaPasta.Application.csproj" />
    <ProjectReference Include="..\EnsenameLaPasta.Infrastructure\EnsenameLaPasta.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Manuales (fuente única en 06_Documentacion) copiados a la salida para servirlos como Ayuda in-app. -->
  <ItemGroup>
    <Content Include="..\..\06_Documentacion\Manuales\MANUAL_USUARIO.md" Link="Help\MANUAL_USUARIO.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\06_Documentacion\Manuales\GLOSARIO.md" Link="Help\GLOSARIO.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\06_Documentacion\Manuales\GUIA_INSTALACION.md" Link="Help\GUIA_INSTALACION.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>ec4c9dad-4d3c-4e55-aec9-84824bdf67cf</UserSecretsId>
  </PropertyGroup>

</Project>
