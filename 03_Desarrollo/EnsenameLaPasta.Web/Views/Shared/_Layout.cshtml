<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        // Aplica el tema guardado antes de pintar (evita parpadeo claro→oscuro).
        (function () { try { document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('theme') || 'light'); } catch (e) { } })();
    </script>
    <title>@ViewData["Title"] - Enseñame la Pasta</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnsenameLaPasta.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm bg-body-tertiary border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Dashboard" asp-action="Index">🤖 Enseñame la Pasta</a>
                <button id="themeToggle" type="button" class="btn btn-sm btn-outline-secondary ms-auto" title="Cambiar tema claro/oscuro">
                    <span id="themeIcon">🌙</span>
                </button>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            &copy; 2026 - Enseñame la Pasta
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Toggle de tema claro/oscuro (Bootstrap 5.3 data-bs-theme) + persistencia.
        (function () {
            var btn = document.getElementById('themeToggle');
            var icon = document.getElementById('themeIcon');
            function current() { return document.documentElement.getAttribute('data-bs-theme') || 'light'; }
            function paintIcon() { if (icon) icon.textContent = current() === 'dark' ? '☀️' : '🌙'; }
            paintIcon();
            if (btn) btn.addEventListener('click', function () {
                var next = current() === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', next);
                try { localStorage.setItem('theme', next); } catch (e) { }
                paintIcon();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
