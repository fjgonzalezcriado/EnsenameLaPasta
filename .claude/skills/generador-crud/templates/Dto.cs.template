using AutoMapper;
using {{Namespace}}.Domain.Entities;

public class {{Entidad}}MappingProfile : Profile
{
    public {{Entidad}}MappingProfile()
    {
        // Entity → DTO
        CreateMap<{{Entidad}}, {{Entidad}}Dto>();
        CreateMap<{{Entidad}}, {{Entidad}}ListDto>();
        CreateMap<{{Entidad}}, {{Entidad}}SelectDto>();

        // Request → Command (si se usa MediatR)
        // CreateMap<Create{{Entidad}}Request, Create{{Entidad}}Command>();
        // CreateMap<Update{{Entidad}}Request, Update{{Entidad}}Command>();
    }
}

