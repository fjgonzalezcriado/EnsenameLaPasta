// ═══════════════════════════════════════════════════════════════════════════
// VALIDATOR PARA ACTUALIZAR
// ═══════════════════════════════════════════════════════════════════════════

public class Update{{Entidad}}CommandValidator : AbstractValidator<Update{{Entidad}}Command>
{
    private readonly I{{Entidad}}Repository _repository;

    public Update{{Entidad}}CommandValidator(I{{Entidad}}Repository repository)
    {
        _repository = repository;

        RuleFor(x => x.Id)
            .NotEmpty().WithMessage("El ID es obligatorio")
            .MustAsync(ExistirEntidad).WithMessage("{{Entidad}} no encontrado/a");

        {{ReglasValidacionActualizar}}
    }

    private async Task<bool> ExistirEntidad(int id, CancellationToken ct)
    {
        return await _repository.ExistsAsync(id, ct);
    }

    {{MetodosValidacionAsyncActualizar}}
}

