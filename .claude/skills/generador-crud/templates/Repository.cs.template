public class {{Entidad}}Repository : I{{Entidad}}Repository
{
    private readonly ApplicationDbContext _context;

    public {{Entidad}}Repository(ApplicationDbContext context)
    {
        _context = context;
    }

    public async Task<{{Entidad}}?> GetByIdAsync(int id, CancellationToken ct = default)
    {
        return await _context.{{Entidades}}
            .FirstOrDefaultAsync(e => e.Id == id, ct);
    }

    public async Task<PaginatedResult<{{Entidad}}>> GetPaginatedAsync(
        int page,
        int size,
        CancellationToken ct = default)
    {
        var query = _context.{{Entidades}}.AsNoTracking();

        var totalCount = await query.CountAsync(ct);

        var items = await query
            .OrderByDescending(e => e.CreatedAt)
            .Skip((page - 1) * size)
            .Take(size)
            .ToListAsync(ct);

        return new PaginatedResult<{{Entidad}}>(items, totalCount, page, size);
    }

    public async Task<IReadOnlyList<{{Entidad}}>> GetAllAsync(CancellationToken ct = default)
    {
        return await _context.{{Entidades}}
            .AsNoTracking()
            .OrderByDescending(e => e.CreatedAt)
            .ToListAsync(ct);
    }

    public async Task<{{Entidad}}> AddAsync({{Entidad}} entity, CancellationToken ct = default)
    {
        await _context.{{Entidades}}.AddAsync(entity, ct);
        return entity;
    }

    public Task UpdateAsync({{Entidad}} entity, CancellationToken ct = default)
    {
        _context.{{Entidades}}.Update(entity);
        return Task.CompletedTask;
    }

    public async Task<bool> ExistsAsync(int id, CancellationToken ct = default)
    {
        return await _context.{{Entidades}}
            .AnyAsync(e => e.Id == id, ct);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // MÉTODOS ESPECÍFICOS
    // ═══════════════════════════════════════════════════════════════════════

    {{ImplementacionMetodosEspecificos}}
}

