    Task<PaginatedResult<{{Entidad}}>> GetPaginatedAsync(int page, int size, CancellationToken ct = default);
    Task<IReadOnlyList<{{Entidad}}>> GetAllAsync(CancellationToken ct = default);
    Task<{{Entidad}}> AddAsync({{Entidad}} entity, CancellationToken ct = default);
