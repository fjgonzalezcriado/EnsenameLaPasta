#region Create{{Entidad}}Command

public record Create{{Entidad}}Command : IRequest<{{Entidad}}Dto>
{
    {{PropiedadesCommand}}
}

public class Create{{Entidad}}CommandHandler
    : IRequestHandler<Create{{Entidad}}Command, {{Entidad}}Dto>
{
    private readonly I{{Entidad}}Repository _repository;
    private readonly IUnitOfWork _unitOfWork;
    private readonly IMapper _mapper;
    private readonly ILogger<Create{{Entidad}}CommandHandler> _logger;

    public Create{{Entidad}}CommandHandler(
        I{{Entidad}}Repository repository,
        IUnitOfWork unitOfWork,
        IMapper mapper,
        ILogger<Create{{Entidad}}CommandHandler> logger)
    {
        _repository = repository;
        _unitOfWork = unitOfWork;
        _mapper = mapper;
        _logger = logger;
    }

    public async Task<{{Entidad}}Dto> Handle(
        Create{{Entidad}}Command request,
        CancellationToken cancellationToken)
    {
        // Crear entidad usando factory del dominio
        var entity = {{Entidad}}.Crear(
            {{ArgumentosCrear}}
        );

        // Persistir
        await _repository.AddAsync(entity, cancellationToken);
        await _unitOfWork.SaveChangesAsync(cancellationToken);

        _logger.LogInformation(
            "{{Entidad}} {Id} creado/a",
            entity.Id);

        return _mapper.Map<{{Entidad}}Dto>(entity);
    }
}

#endregion

#region Update{{Entidad}}Command

public record Update{{Entidad}}Command : IRequest
{
    public int Id { get; init; }
    {{PropiedadesCommand}}
}

public class Update{{Entidad}}CommandHandler : IRequestHandler<Update{{Entidad}}Command>
{
    private readonly I{{Entidad}}Repository _repository;
    private readonly IUnitOfWork _unitOfWork;
    private readonly ILogger<Update{{Entidad}}CommandHandler> _logger;

    public Update{{Entidad}}CommandHandler(
        I{{Entidad}}Repository repository,
        IUnitOfWork unitOfWork,
        ILogger<Update{{Entidad}}CommandHandler> logger)
    {
        _repository = repository;
        _unitOfWork = unitOfWork;
        _logger = logger;
    }

    public async Task Handle(
        Update{{Entidad}}Command request,
        CancellationToken cancellationToken)
    {
        var entity = await _repository.GetByIdAsync(request.Id, cancellationToken)
            ?? throw new NotFoundException(nameof({{Entidad}}), request.Id);

        // Actualizar usando método del dominio
        entity.Actualizar(
            {{ArgumentosActualizar}}
        );

        await _repository.UpdateAsync(entity, cancellationToken);
        await _unitOfWork.SaveChangesAsync(cancellationToken);

        _logger.LogInformation(
            "{{Entidad}} {Id} actualizado/a",
            entity.Id);
    }
}

#endregion

#region Delete{{Entidad}}Command

public record Delete{{Entidad}}Command(int Id) : IRequest;

public class Delete{{Entidad}}CommandHandler : IRequestHandler<Delete{{Entidad}}Command>
{
    private readonly I{{Entidad}}Repository _repository;
    private readonly IUnitOfWork _unitOfWork;
    private readonly ICurrentUserService _currentUser;
    private readonly ILogger<Delete{{Entidad}}CommandHandler> _logger;

    public Delete{{Entidad}}CommandHandler(
        I{{Entidad}}Repository repository,
        IUnitOfWork unitOfWork,
        ICurrentUserService currentUser,
        ILogger<Delete{{Entidad}}CommandHandler> logger)
    {
        _repository = repository;
        _unitOfWork = unitOfWork;
        _currentUser = currentUser;
        _logger = logger;
    }

    public async Task Handle(
        Delete{{Entidad}}Command request,
        CancellationToken cancellationToken)
    {
        var entity = await _repository.GetByIdAsync(request.Id, cancellationToken)
            ?? throw new NotFoundException(nameof({{Entidad}}), request.Id);

        // Soft delete usando método del dominio
        entity.Eliminar(_currentUser.UserName ?? "system");

        await _repository.UpdateAsync(entity, cancellationToken);
        await _unitOfWork.SaveChangesAsync(cancellationToken);

        _logger.LogInformation(
            "{{Entidad}} {Id} eliminado/a por {User}",
            entity.Id,
            _currentUser.UserName);
    }
}

#endregion

