using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;
using {{Namespace}}.Domain.Entities;

namespace {{Namespace}}.Infrastructure.Persistence.Configurations;

/// <summary>
/// Configuración de EF Core para {{Entidad}}
/// </summary>
public class {{Entidad}}Configuration : IEntityTypeConfiguration<{{Entidad}}>
{
    public void Configure(EntityTypeBuilder<{{Entidad}}> builder)
    {
        // ═══════════════════════════════════════════════════════════════════
        // TABLA
        // ═══════════════════════════════════════════════════════════════════

        builder.ToTable("{{Entidades}}", "{{Schema}}");

        // ═══════════════════════════════════════════════════════════════════
        // CLAVE PRIMARIA
        // ═══════════════════════════════════════════════════════════════════

        builder.HasKey(e => e.Id);

        builder.Property(e => e.Id)
            .ValueGeneratedOnAdd();

        // ═══════════════════════════════════════════════════════════════════
        // PROPIEDADES
        // ═══════════════════════════════════════════════════════════════════

        {{ConfiguracionPropiedades}}

        // ═══════════════════════════════════════════════════════════════════
        // PROPIEDADES DE AUDITORÍA
        // ═══════════════════════════════════════════════════════════════════

        builder.Property(e => e.CreatedAt)
            .IsRequired();

        builder.Property(e => e.CreatedBy)
            .HasMaxLength(256);

        builder.Property(e => e.ModifiedAt);

        builder.Property(e => e.ModifiedBy)
            .HasMaxLength(256);

        // ═══════════════════════════════════════════════════════════════════
        // SOFT DELETE
        // ═══════════════════════════════════════════════════════════════════

        builder.Property(e => e.IsDeleted)
            .HasDefaultValue(false);

        builder.Property(e => e.DeletedAt);

        builder.Property(e => e.DeletedBy)
            .HasMaxLength(256);

        // Query filter para soft delete
        builder.HasQueryFilter(e => !e.IsDeleted);

        // ═══════════════════════════════════════════════════════════════════
        // ÍNDICES
        // ═══════════════════════════════════════════════════════════════════

        {{ConfiguracionIndices}}

        // ═══════════════════════════════════════════════════════════════════
        // RELACIONES
        // ═══════════════════════════════════════════════════════════════════

        {{ConfiguracionRelaciones}}
    }
}

