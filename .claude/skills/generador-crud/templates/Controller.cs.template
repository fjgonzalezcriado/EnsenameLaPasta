using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using {{Namespace}}.Application.Features.{{Entidades}}.Commands;
using {{Namespace}}.Application.Features.{{Entidades}}.Queries;
using {{Namespace}}.Application.Common.Models;

namespace {{Namespace}}.Api.Controllers;

/// <summary>
/// API REST para gestión de {{Entidades}}
/// </summary>
[ApiController]
[Route("api/[controller]")]
[Produces("application/json")]
public class {{Entidades}}Controller : ControllerBase
{
    private readonly IMediator _mediator;
    private readonly ILogger<{{Entidades}}Controller> _logger;

    public {{Entidades}}Controller(
        IMediator mediator,
        ILogger<{{Entidades}}Controller> logger)
    {
        _mediator = mediator;
        _logger = logger;
    }

    // ═══════════════════════════════════════════════════════════════════════
    // GET - Consultas
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// Obtiene listado paginado de {{Entidades}}
    /// </summary>
    /// <param name="page">Número de página (1-based)</param>
    /// <param name="size">Elementos por página</param>
    /// <param name="ct">Token de cancelación</param>
    /// <returns>Lista paginada de {{Entidades}}</returns>
    [HttpGet]
    [ProducesResponseType<PaginatedResult<{{Entidad}}Dto>>(StatusCodes.Status200OK)]
    public async Task<ActionResult<PaginatedResult<{{Entidad}}Dto>>> GetAll(
        [FromQuery] int page = 1,
        [FromQuery] int size = 10,
        CancellationToken ct = default)
    {
        var query = new Get{{Entidades}}Query(page, size);
        var result = await _mediator.Send(query, ct);
        return Ok(result);
    }

    /// <summary>
    /// Obtiene un/a {{Entidad}} por su ID
    /// </summary>
    /// <param name="id">ID del/de la {{Entidad}}</param>
    /// <param name="ct">Token de cancelación</param>
    /// <returns>{{Entidad}} encontrado/a</returns>
    [HttpGet("{id:int}")]
    [ProducesResponseType<{{Entidad}}Dto>(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<{{Entidad}}Dto>> GetById(
        int id,
        CancellationToken ct = default)
    {
        var query = new Get{{Entidad}}ByIdQuery(id);
        var result = await _mediator.Send(query, ct);

        if (result is null)
        {
            return NotFound(new ProblemDetails
            {
                Title = "{{Entidad}} no encontrado/a",
                Detail = $"No existe un/a {{Entidad}} con ID {id}",
                Status = StatusCodes.Status404NotFound
            });
        }

        return Ok(result);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // POST - Crear
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// Crea un/a nuevo/a {{Entidad}}
    /// </summary>
    /// <param name="request">Datos del/de la {{Entidad}}</param>
    /// <param name="ct">Token de cancelación</param>
    /// <returns>{{Entidad}} creado/a</returns>
    [HttpPost]
    [Authorize(Roles = "Admin,Gestor")]
    [ProducesResponseType<{{Entidad}}Dto>(StatusCodes.Status201Created)]
    [ProducesResponseType<ValidationProblemDetails>(StatusCodes.Status400BadRequest)]
    public async Task<ActionResult<{{Entidad}}Dto>> Create(
        [FromBody] Create{{Entidad}}Command request,
        CancellationToken ct = default)
    {
        var result = await _mediator.Send(request, ct);

        _logger.LogInformation(
            "{{Entidad}} {Id} creado/a por {User}",
            result.Id,
            User.Identity?.Name);

        return CreatedAtAction(
            nameof(GetById),
            new { id = result.Id },
            result);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PUT - Actualizar
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// Actualiza un/a {{Entidad}} existente
    /// </summary>
    /// <param name="id">ID del/de la {{Entidad}}</param>
    /// <param name="request">Datos actualizados</param>
    /// <param name="ct">Token de cancelación</param>
    /// <returns>Sin contenido si éxito</returns>
    [HttpPut("{id:int}")]
    [Authorize(Roles = "Admin,Gestor")]
    [ProducesResponseType(StatusCodes.Status204NoContent)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    [ProducesResponseType<ValidationProblemDetails>(StatusCodes.Status400BadRequest)]
    public async Task<IActionResult> Update(
        int id,
        [FromBody] Update{{Entidad}}Command request,
        CancellationToken ct = default)
    {
        if (id != request.Id)
        {
            return BadRequest(new ProblemDetails
            {
                Title = "ID no coincide",
                Detail = "El ID de la URL no coincide con el ID del body",
                Status = StatusCodes.Status400BadRequest
            });
        }

        await _mediator.Send(request, ct);

        _logger.LogInformation(
            "{{Entidad}} {Id} actualizado/a por {User}",
            id,
            User.Identity?.Name);

        return NoContent();
    }

    // ═══════════════════════════════════════════════════════════════════════
    // DELETE - Eliminar
    // ═══════════════════════════════════════════════════════════════════════

    /// <summary>
    /// Elimina un/a {{Entidad}} (soft delete)
    /// </summary>
    /// <param name="id">ID del/de la {{Entidad}}</param>
    /// <param name="ct">Token de cancelación</param>
    /// <returns>Sin contenido si éxito</returns>
    [HttpDelete("{id:int}")]
    [Authorize(Roles = "Admin")]
    [ProducesResponseType(StatusCodes.Status204NoContent)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<IActionResult> Delete(
        int id,
        CancellationToken ct = default)
    {
        var command = new Delete{{Entidad}}Command(id);
        await _mediator.Send(command, ct);

        _logger.LogInformation(
            "{{Entidad}} {Id} eliminado/a por {User}",
            id,
            User.Identity?.Name);

        return NoContent();
    }
}

